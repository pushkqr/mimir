# ── Mimir Engine · Environment Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.

# ── Google Cloud / Vertex AI ───────────────────────────────────────────────────
# Required for generative answering (Gemini) and ingestion-time translation (GCP)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1         # e.g. us-central1, asia-south1
USE_VERTEX_AI=True                        # Set False to use AI Studio API key instead
# GEMINI_API_KEY=your_ai_studio_key       # Only needed if USE_VERTEX_AI=False

# ── Model Configuration ────────────────────────────────────────────────────────
GEN_MODEL_NAME=gemini-2.5-flash           # Main generative model (Vertex AI)
SPEC_MODEL_NAME=gemini-2.5-flash          # Specialist model (translation fallback etc.)

# ── Embeddings: Self-Hosted BGE-M3 via Infinity ───────────────────────────────
# Deploy: pip install infinity-emb[all] && infinity_emb v2 --model-id BAAI/bge-m3 --port 7997
# All ingestion and query embeddings are routed through this endpoint.
LOCAL_EMBED_URL=http://<YOUR_EMBED_HOST>:7997/embeddings
LOCAL_EMBED_API_KEY=                      # Leave empty if your Infinity server is unsecured
LOCAL_EMBED_MODEL_NAME=BAAI/bge-m3
LOCAL_EMBED_TIMEOUT_S=10
USE_AISTUDIO_FOR_EMBEDDINGS=False         # Ignored when LOCAL_EMBED_URL is set
EMBED_MODEL_NAME=BAAI/bge-m3              # Informational — used as model name in API payload

# Ingestion-time batch embedding (core/utils.py:embed_batch_safe). Query-time embedding
# always stays single-item and uses LOCAL_EMBED_TIMEOUT_S above, untouched by these.
#
# These two are one decision, not two. Embedding cost scales with total tokens, so on CPU a
# ~500-token passage takes ~3.4s and a 64-item batch of them needs ~217s. Paired with the old
# 60s timeout that batch could never complete, and the failure was selective: short-passage
# documents passed while the largest documents in the corpus timed out and were dropped.
# Raise the batch only if you also raise the timeout, and size both against your own corpus.
EMBED_BATCH_SIZE=16
LOCAL_EMBED_BATCH_TIMEOUT_S=300

# Optional: Self-hosted BGE reranking via the same Infinity server.
LOCAL_RERANK_URL=http://<YOUR_EMBED_HOST>:7997/rerank
LOCAL_RERANK_API_KEY=                     # Leave empty if your Infinity server is unsecured
LOCAL_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
# Disaster bound, not a tuning knob: reranking runs ~3.5s warm, so this only caps how long
# a hung reranker can stall a query before it falls back to unranked order.
LOCAL_RERANK_TIMEOUT_S=10

# Fast-mode retrieval tuning. Reranking is the dominant latency cost (~60% of a response),
# so CANDIDATE_LIMIT trades response time against recall fairly directly.
FAST_MODE_CANDIDATE_LIMIT=12
FAST_MODE_RERANK_LIMIT=8
FAST_MODE_MAX_CHUNKS_PER_DOC=4            # Cap chunks per document, prevents evidence pile-on
DEEP_MODE_CANDIDATE_LIMIT=150             # Deep mode is not exposed in the product
DEEP_MODE_RERANK_LIMIT=12

# ── Translation Microservice (IndicTrans2) ─────────────────────────────────────
# Required for Marathi/Hindi query detection and translation at retrieval time.
# Ingestion-time translation uses GCP Cloud Translation v3 (via GOOGLE_CLOUD_PROJECT).
# Port 8001 is the published port. The container listens on 8000 internally; pointing this
# at 8000 reaches nothing, and a failed translation degrades silently to searching the
# English corpus with an untranslated Devanagari query.
TRANSLATION_SERVICE_URL=http://<YOUR_TRANSLATION_HOST>:8001/translate
TRANSLATE_LOCATION=global                 # GCP translation location (global or region)

# ── Cerebras (Fast Inference) ──────────────────────────────────────────────────
# Required for the agentic reasoning loop (<2s latency)
CEREBRAS_API_KEY=your_cerebras_api_key

# Cerebras enforces 5 requests/minute PER MODEL, so this list is effectively the
# rate-limit budget: each model added multiplies available throughput. Widen it if
# concurrent users start hitting 429s.
CEREBRAS_MODELS=gpt-oss-120b,gemma-4-31b

# Follow-up questions ("what is the number of this GR") are rewritten into standalone
# queries before search, otherwise they retrieve without their antecedent. Costs one
# extra Cerebras request per follow-up; set false to reclaim that rate-limit headroom.
CONTEXTUALIZE_FOLLOWUPS=true
CONTEXTUALIZE_TIMEOUT_S=4                 # Best-effort: on timeout, search the raw query

# ── Weaviate (Vector Database) ────────────────────────────────────────────────
# Leave WEAVIATE_URL empty to connect to a local Weaviate instance (docker-compose)
WEAVIATE_URL=http://<YOUR_WEAVIATE_IP>    # e.g. http://206.189.x.x
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=                         # Leave empty if Weaviate auth is disabled

# ── Security & Authentication ──────────────────────────────────────────────────
# Comma-separated CIDRs allowed to reach query and admin endpoints. Requests from
# outside are refused with 403 before authentication is even checked.
# IMPORTANT: if this key is absent the code falls back to loopback plus RFC1918 private
# ranges only, which blocks every public client. Set it explicitly.
#   Department deployment: MIMIR_ALLOWED_SUBNETS=10.0.0.0/8
#   Public demo:           MIMIR_ALLOWED_SUBNETS=0.0.0.0/0
MIMIR_ALLOWED_SUBNETS=0.0.0.0/0

# Officer portal password. Leave empty to disable auth (not recommended for production).
MIMIR_AUTH_TOKEN=your_secure_officer_password

# Admin token for the token CRUD API (POST/GET/DELETE /api/admin/tokens).
MIMIR_ADMIN_TOKEN=your_secure_admin_token

# Seeds two fixed officer tokens (OFFICER-TOKEN-1/2) for local development. Those strings
# are in the public source, and /api/login is unauthenticated, so never set this on a
# deployment reachable from outside your machine. Issue real tokens from the admin panel.
# MIMIR_SEED_DEMO_TOKENS=true

# ── Optional: API Throttle Delays ─────────────────────────────────────────────
# Increase if you hit rate limits. Values in seconds. Default is 0 (no delay).
# GEN_API_DELAY=1.0
# EMBED_API_DELAY=0.0
# CEREBRAS_API_DELAY=0.5

# Generation provider. "cerebras" (default) uses the hosted API; "local" points generation at
# any OpenAI-compatible server on your own hardware (Ollama, vLLM, llama.cpp, LM Studio).
# Switching to local is what makes the deployment fully self-hosted; see microservices/README.md.
# Left commented out (the code already defaults to "cerebras" when unset): DEPLOYMENT_MODE=
# sovereign below needs this line absent to actually take effect. Setting it explicitly here,
# to either value, always wins over DEPLOYMENT_MODE - uncomment only if you want to pin
# generation independently of the overall mode.
# GEN_PROVIDER=cerebras
LOCAL_GEN_URL=http://localhost:11500/v1
LOCAL_GEN_MODEL=qwen3:4b
LOCAL_GEN_TIMEOUT_S=120

# DEPLOYMENT_MODE=hybrid|sovereign (core/deployment.py) sets the default for four provider
# switches at once: GEN_PROVIDER above, plus the three below. Each remains individually
# overridable - set DEPLOYMENT_MODE=sovereign and uncomment any one of the four explicitly to
# keep just that one on hybrid. Leave DEPLOYMENT_MODE unset (or "hybrid") for today's default.
# DEPLOYMENT_MODE=sovereign

# PDF OCR tier 2, reached only when the local PyMuPDF parser yields too little text.
# "docai" (default) = Google Document AI. "docling" = the self-hosted microservices/docling/.
# Commented out for the same reason as GEN_PROVIDER above - leave absent so DEPLOYMENT_MODE
# controls it; uncomment only to pin this one switch independently.
# PDF_PARSE_TIER2_PROVIDER=docai
DOCLING_SERVICE_URL=http://localhost:8002/parse
DOCLING_TIMEOUT_S=120

# Ingest-time structuring of raw OCR text into Markdown headers.
# "gemini" (default) = Gemini Flash. "local" = the same OpenAI-compatible server GEN_PROVIDER
# uses (LOCAL_GEN_URL/LOCAL_GEN_MODEL above). Commented out for the same reason as above.
# INGEST_STRUCTURE_PROVIDER=gemini

# Ingest-time Marathi-to-English translation for source documents.
# "gcp" (default) = GCP Cloud Translation. "indictrans2" = the self-hosted
# microservices/translation/ service (same one query-time translation already uses via
# TRANSLATION_SERVICE_URL above). Note: the microservice translates one chunk per request,
# unlike GCP's batch API, so this path is slower - the same self-hosted-costs-time tradeoff
# as GEN_PROVIDER=local. Commented out for the same reason as the other three switches above.
# INGEST_TRANSLATE_PROVIDER=gcp
# Governs both query-time and ingest-time translation. The service answers a query in ~2.5s
# on an idle instance, but ingest chunks are larger and the ingest model is slower, so the
# budget has to clear the worst case rather than the typical one.
TRANSLATION_TIMEOUT_S=15
