# Environments
.env
.env.backup-*
# The live backup on the app instance is named .env.bak-presovereign, which .env.backup-*
# does not match. It holds every credential in the deployment.
.env.bak*
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
temp/
*.csv
docs/
gcp-key.json
weaviate_data/
data/*
# The citation graph is derived from the corpus but cheap to ship and slow to rebuild
# (a full scan of every chunk), so the deployment starts with it already populated.
!data/citation_graph.json
!data/docker-compose.yml
CLAUDE.md
skills-lock.json
mahGRs-main/
# mimir-aws-stack.yaml is tracked: every secret it needs is a NoEcho parameter with no
# default, so the template itself carries nothing sensitive. The values do NOT belong in
# the repo, and they live in the parameters file below.
params.json
*-params.json
cfn-params*.json
mimir-key.pem
*.pem

# Qdrant Database
local_qdrant_db/

